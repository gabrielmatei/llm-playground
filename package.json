{
  "name": "llm-playground",
  "private": true,
  "packageManager": "pnpm@9.0.0",
  "scripts": {
    "lint": "eslint .",
    "format": "prettier . --write",
    "typecheck": "tsc -b",
    "exp:01": "pnpm --filter @exp/01-basic-chat dev",
    "exp:02": "pnpm --filter @exp/02-prompt-patterns dev",
    "exp:03": "pnpm --filter @exp/03-structured-output dev",
    "exp:04": "pnpm --filter @exp/04-streaming dev",
    "exp:05": "pnpm --filter @exp/05-retries-timeouts dev",
    "exp:06": "pnpm --filter @exp/06-single-tool-calling dev",
    "exp:07": "pnpm --filter @exp/07-multi-step-agent-loop dev",
    "exp:08": "pnpm --filter @exp/08-tool-error-recovery dev",
    "exp:09": "pnpm --filter @exp/09-dynamic-tool-routing dev",
    "exp:10": "pnpm --filter @exp/10-memory-agent dev"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}